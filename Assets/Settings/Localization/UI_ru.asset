  - m_Id: 6110216678719488
    m_Localized: "\u0413\u041B\u0410\u0412\u041D\u041E\u0415 \u041C\u0415\u041D\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 8312222965219328
    m_Localized: "\u0420\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u043C\u044B\u0439
      \u0447\u0430\u043D\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 12711559031865344
    m_Localized: "\u041F\u041E \u0423\u041C\u041E\u041B\u0427\u0410\u041D\u0418\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 13058139958198272
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0432\u0438\u0434 \u0447\u0430\u043D\u043A\u0430
      \u0438\u043C\u0435\u0435\u0442 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
      0.00\u20131.00 (\u0443 \u0431\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u0447\u0430\u043D\u043A\u0430
      \u043C\u0438\u043D\u0438\u043C\u0443\u043C 0.3). \u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043D\u043E\u0432\u043E\u0433\u043E \u0447\u0430\u043D\u043A\u0430 \u0438\u0433\u0440\u0430
      \u0431\u0435\u0440\u0451\u0442 \u0441\u0443\u043C\u043C\u0443 \u0432\u0441\u0435\u0445
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044E \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u0435\u0433\u043E \u0434\u043E\u043B\u0435.\r\n\u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u0435\u0441\u043B\u0438 \u0431\u0430\u0437\u043E\u0432\u044B\u0439 = 0.8,
      \u0441 \u043F\u043E\u0442\u043E\u043B\u043A\u043E\u043C = 0.4, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E 0.2, \u0442\u043E \u0448\u0430\u043D\u0441\u044B:\r\n44% \u2013
      \u0431\u0430\u0437\u043E\u0432\u044B\u0439, 22% \u2013 \u0441 \u043F\u043E\u0442\u043E\u043B\u043A\u043E\u043C,
      \u043F\u043E 11% \u2013 \u0434\u0440\u0443\u0433\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 13058096987553792
    m_Localized: "\u0415\u0441\u0442\u044C \u043F\u044F\u0442\u044C \u0432\u0438\u0434\u043E\u0432
      \u0447\u0430\u043D\u043A\u043E\u0432:\n\n\u2022 \u0411\u0430\u0437\u043E\u0432\u044B\u0439
      \u0447\u0430\u043D\u043A - \u0447\u0430\u043D\u043A \u0441 \u0432\u0440\u0430\u0433\u0430\u043C\u0438
      \u0438 \u043B\u043E\u0432\u0443\u0448\u043A\u0430\u043C\u0438.\n\n\u2022 \u0427\u0430\u043D\u043A
      \u0441 \u043F\u043E\u0442\u043E\u043B\u043A\u043E\u043C - \u0447\u0430\u043D\u043A
      \u0441 \u043F\u043E\u0442\u043E\u043B\u043A\u043E\u043C \u0438 \u043B\u043E\u0432\u0443\u0448\u043A\u0430\u043C\u0438
      \u043D\u0430 \u043D\u0435\u043C.\n\n\u2022 \u0427\u0430\u043D\u043A \u0441\u0435\u0442\u0447\u0430\u0442\u044B\u0445
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C - \u0447\u0430\u043D\u043A
      \u0441 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u043C\u0438,
      \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0438\u0433\u0440\u043E\u043A
      \u043F\u0440\u044B\u0433\u0430\u0435\u0442.\n\n\u2022 \u0427\u0430\u043D\u043A
      \u0441 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u043C\u0438\u0441\u044F \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u043C\u0438
      - \u0447\u0430\u043D\u043A \u0441 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u043C\u0438\u0441\u044F
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u0434\u044A\u0435\u0437\u0436\u0430\u044E\u0442 \u0434\u0440\u0443\u0433
      \u043A \u0434\u0440\u0443\u0433\u0443.\n\n\u2022 \u0420\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u043C\u044B\u0439
      \u0447\u0430\u043D\u043A - \u0447\u0430\u043D\u043A \u0441 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044E\u0449\u0438\u043C\u0441\u044F
      \u043F\u043E\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 13057949494853632
    m_Localized: "\u0417\u0430\u0434\u0430\u0451\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \xAB\u0447\u0430\u043D\u043A\u043E\u0432\xBB
      (\u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432) \u043F\u043E\u0434\u0440\u044F\u0434
      \u0431\u0443\u0434\u0435\u0442 \u0432 \u0443\u0440\u043E\u0432\u043D\u0435."
    m_Metadata:
      m_Items: []
